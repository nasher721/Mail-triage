# Copy to ~/.config/email-triage/env with mode 600 for scheduled runs:
#   install -m 600 .env.example ~/.config/email-triage/env
# The CLI reads it with --env-file and refuses any file other users can read.

# Graph registration is optional. With both values absent, credential-free OWA
# is selected automatically:
#   bash scripts/open_outlook_in_edge.sh
#   python3 email_triage_standalone.py --owa --apply --watch
# MS_TENANT_ID=your-tenant-id
# MS_CLIENT_ID=your-public-client-application-id

# Outlook on the web in a dedicated Microsoft Edge profile (no Entra admin).
# TRIAGE_SOURCE=owa
# EDGE_CDP_URL=http://127.0.0.1:9222
# Experimental visible unread Inbox rows on macOS (separate atomacos install):
# TRIAGE_SOURCE=accessibility

# AI provider. Local Ollama is the default for both screening and the sorting
# agent: email bodies stay on this machine, so EXTERNAL_AI_APPROVED is not
# required. Run `python email_triage_standalone.py --list-providers` for the full
# list (ollama, lmstudio, llamacpp, opencode, openai, anthropic, openrouter,
# azure-openai, gemini, groq, mistral, deepseek, together, xai, custom).
TRIAGE_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Generic overrides applied to whichever provider is selected.
# TRIAGE_MODEL=
# TRIAGE_BASE_URL=
# TRIAGE_API_KEY=
# TRIAGE_TEMPERATURE=0.2
# TRIAGE_REQUEST_TIMEOUT=180
# TRIAGE_AGENT_MAX_ROUNDS=4

# Run the sorting agent on a different system than screening. It never sees
# message bodies, only the structured screening result.
# TRIAGE_AGENT_PROVIDER=ollama
# TRIAGE_AGENT_MODEL=
# TRIAGE_AGENT_BASE_URL=
# TRIAGE_AGENT_API_KEY=

# Screen exported or synthetic mail without Microsoft Graph:
# TRIAGE_INPUT=samples/inbox.jsonl

# Mailbox changes. Defaults are off; the CLI flags --apply / --mark-read set them per run.
# TRIAGE_APPLY writes to Outlook: moves, categories, and unsent reply drafts. Never sends.
# TRIAGE_MARK_READ additionally marks filed mail read (never for needs_review).
# TRIAGE_AGENT=false skips the local sorting agent and uses the deterministic plan.
TRIAGE_APPLY=false
TRIAGE_MARK_READ=false
TRIAGE_AGENT=true

# Hosted providers (optional). Each needs its own key and an explicit approval.
# TRIAGE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-a-new-key
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# TRIAGE_PROVIDER=openai
# OPENAI_API_KEY=replace-with-a-new-key
# OPENAI_MODEL=gpt-4o
#
# TRIAGE_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-with-a-new-key
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
#
# Azure OpenAI and self-hosted gateways need an explicit base URL:
# TRIAGE_PROVIDER=azure-openai
# AZURE_OPENAI_API_KEY=replace-with-a-new-key
# AZURE_OPENAI_BASE_URL=https://resource.openai.azure.com/openai/deployments/gpt-4o?api-version=2024-10-21
#
# Required before any of the above receives message text:
# EXTERNAL_AI_APPROVED=false

MAX_UNREAD_MESSAGES=20
MAX_BODY_CHARACTERS=12000
TRIAGE_OUTPUT_DIR=var
