# Copy to ~/.config/email-triage/env with mode 600 for scheduled runs:
#   install -m 600 .env.example ~/.config/email-triage/env
# The CLI reads it with --env-file and refuses any file other users can read.

# Microsoft Graph app registration. Optional when Outlook is already open in Edge:
#   bash scripts/open_outlook_in_edge.sh
#   python3 email_triage_standalone.py --owa --apply --watch
# MS_TENANT_ID=your-tenant-id
# MS_CLIENT_ID=your-public-client-application-id

# Outlook on the web in Microsoft Edge (no Entra admin). Same as --owa.
# TRIAGE_SOURCE=owa
# EDGE_CDP_URL=http://127.0.0.1:9222

# Local Ollama is the default backend for both screening and the sorting agent.
# Email bodies stay on this machine, so EXTERNAL_AI_APPROVED is not required.
TRIAGE_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Screen exported or synthetic mail without Microsoft Graph:
# TRIAGE_INPUT=samples/inbox.jsonl

# Mailbox changes. Defaults are off; the CLI flags --apply / --mark-read set them per run.
# TRIAGE_APPLY writes to Outlook: moves, categories, and unsent reply drafts. Never sends.
# TRIAGE_MARK_READ additionally marks filed mail read (never for needs_review).
# TRIAGE_AGENT=false skips the local sorting agent and uses the deterministic plan.
TRIAGE_APPLY=false
TRIAGE_MARK_READ=false
TRIAGE_AGENT=true

# Cloud screening backend (optional). Requires a new key and explicit approval.
# The sorting agent stays local regardless.
# TRIAGE_BACKEND=openai
# OPENAI_API_KEY=replace-with-a-new-key
# OPENAI_MODEL=gpt-4o
# EXTERNAL_AI_APPROVED=false

MAX_UNREAD_MESSAGES=20
MAX_BODY_CHARACTERS=12000
TRIAGE_OUTPUT_DIR=var
