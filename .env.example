# Optional. Leave blank and use --input samples/inbox.jsonl if you do not have Graph access.
# MS_TENANT_ID=your-tenant-id
# MS_CLIENT_ID=your-public-client-application-id

# Local Ollama is the default backend. Email bodies stay on this machine,
# so EXTERNAL_AI_APPROVED is not required. Best fit on an 18GB M3 Pro: qwen3:8b.
TRIAGE_BACKEND=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Screen exported or synthetic mail without Microsoft Graph:
# TRIAGE_INPUT=samples/inbox.jsonl

# Cloud backend (optional). Requires a new key and explicit approval.
# TRIAGE_BACKEND=openai
# OPENAI_API_KEY=replace-with-a-new-key
# OPENAI_MODEL=gpt-4o
# EXTERNAL_AI_APPROVED=false

# Review-only limits. The application never sends, moves, categorizes, or marks mail read.
MAX_UNREAD_MESSAGES=20
MAX_BODY_CHARACTERS=12000
TRIAGE_OUTPUT_DIR=var


